@page "/"
@inject IAppointmentRepository AppointmentRepository

<PageTitle>Today's Schedule</PageTitle>

<h1>Today's Schedule</h1>
<p class="text-muted">@DateTime.Today.ToString("dddd, d MMMM yyyy")</p>

@if (_loading)
{
    <p>Loading...</p>
}
else if (!_appointments.Any())
{
    <div class="alert alert-info">No appointments scheduled for today.</div>
}
else
{
    @foreach (var group in _appointments.GroupBy(a => a.MechanicName).OrderBy(g => g.Key))
    {
        <h4 class="mt-4">@group.Key</h4>
        <table class="table table-sm table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Time</th>
                    <th>Customer Name</th>
                    <th>Vehicle Reg</th>
                    <th>Service Type</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in group)
                {
                    <tr>
                        <td class="text-nowrap">@a.StartTime.ToString("HH:mm") &ndash; @a.EndTime.ToString("HH:mm")</td>
                        <td>@a.CustomerName</td>
                        <td><code>@a.VehicleReg</code></td>
                        <td>@a.ServiceTypeName</td>
                        <td><span class="badge @StatusBadge(a.Status)">@a.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<Appointment> _appointments = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _appointments = (await AppointmentRepository.GetTodayAllAsync()).ToList();
        _loading = false;
    }

    private static string StatusBadge(string status) => status switch
    {
        "Scheduled"  => "bg-primary",
        "InProgress" => "bg-warning text-dark",
        "Completed"  => "bg-success",
        "NoShow"     => "bg-secondary",
        _            => "bg-secondary"
    };
}
